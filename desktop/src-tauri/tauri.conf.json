{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clippy",
  "version": "0.3.2-rc.2",
  "identifier": "com.helal.clippy",
  "build": {
    "beforeDevCommand": "npm --prefix ../../dashboard run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clippy",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:*; media-src 'self' asset: http://asset.localhost blob: http://127.0.0.1:*"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Video",
    "shortDescription": "Local AI video clipping and editing",
    "longDescription": "Clippy is a local-first AI video clipping and editing application.",
    "resources": {
      "resources/app-payload.zip": "app-payload.zip",
      "resources/app-payload.sha256": "app-payload.sha256"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNUJCMEVGOEY4MzEzRjMKUldUekU0T1A3N0JieXVDTlZ0L1RkOVlhU3BOekI4NVdmeGdjRW9KRjQvTklqZE9EdzdCaHlBTzMK",
      "endpoints": [
        "https://github.com/helalxp/clippy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
